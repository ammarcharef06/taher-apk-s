{
  "name": "taher-accounting-ng",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @taher/web dev",
    "build": "pnpm --filter @taher/web build",
    "build:android": "pnpm --dir apps/mobile build",
    "build:desktop": "pnpm --dir apps/desktop build",
    "android:add": "pnpm --dir apps/mobile exec cap add android",
    "typecheck": "pnpm --filter @taher/core typecheck && pnpm --filter @taher/web typecheck",
    "preview": "pnpm --filter @taher/web preview",
    "test": "pnpm --filter @taher/core test"
  }
}
